# Firewalla MSP API Configuration
# Copy this file to .env and fill in your actual credentials

# Your Firewalla MSP API access token
# Get this from your MSP portal at https://yourdomain.firewalla.net
# Navigate to Account Settings > API Settings > Generate Personal Access Token
FIREWALLA_MSP_TOKEN=your_msp_access_token_here

# Your Firewalla MSP domain (e.g., yourdomain.firewalla.net)
# Format: yourdomain.firewalla.net (without https://)
FIREWALLA_MSP_ID=yourdomain.firewalla.net

# Optional: Your Firewalla Box Global ID (GID)
# This is optional - you can retrieve box IDs via the get_boxes tool
# If not provided, API calls will return data for all boxes you have access to
# Find this in the box details in your MSP portal
# Format: UUID like 00000000-0000-0000-0000-000000000000
# FIREWALLA_BOX_ID=your_box_gid_here

# Optional: default box for single-box operations (get_specific_alarm,
# archive_alarm, mute_alarm, create_rule, rename_device) when no gid is passed.
# Unlike FIREWALLA_BOX_ID it does not filter queries. With neither set, those
# operations use the account's only box, or on a multi-box account need gid
# (the alarm tools check each box for the alarm instead).
# FIREWALLA_DEFAULT_BOX_ID=your_default_box_gid_here

# Optional: register the write tools create_rule, delete_rule, rename_device,
# archive_alarm and mute_alarm (default: off).
# FIREWALLA_ENABLE_WRITE_TOOLS=true

# Optional: API timeout in milliseconds (default: 30000, range 1000-300000)
API_TIMEOUT=30000

# Optional: API requests per 5 minutes (default: 100, range 1-1000).
# The MSP API accepts 100 per token in each 5-minute window. A request over
# the limit waits for a slot if one frees within 20 s, else fails at once
# saying when capacity returns. Lower it when other clients use the same
# token. (Earlier versions called it requests per minute but never applied it.)
# API_RATE_LIMIT=100

# Optional: Cache TTL in seconds (default: 300, range 0-3600)
# Controls how long API responses are cached
CACHE_TTL=300

# Optional: Transport configuration
# MCP_TRANSPORT: Transport type - 'stdio' for standard input/output (default) or 'http' for HTTP server
# Default: stdio
MCP_TRANSPORT=stdio

# MCP_HTTP_PORT: Port for HTTP server (only used when MCP_TRANSPORT=http)
# Default: 3000
MCP_HTTP_PORT=3000

# MCP_HTTP_PATH: Path for HTTP server endpoint (only used when MCP_TRANSPORT=http)
# Default: /mcp
MCP_HTTP_PATH=/mcp

# Optional: Debug settings
# Enable specific debug namespaces for troubleshooting
# DEBUG=firewalla:*
# DEBUG=cache,performance,api
# DEBUG=validation,error-handler
# DEBUG=query,optimization
# DEBUG=pipeline,data-processing